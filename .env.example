# API server
PORT=3001

# Local PostgreSQL started by docker-compose.postgres.yml
DATABASE_URL=postgresql://nhl_app:change-me-local-only@localhost:5432/nhl_coaching
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_SSL=false

# Vite frontend. Use /api when the frontend is proxied through the same host.
# For local development this can be http://localhost:3001/api.
VITE_NHL_API_BASE_URL=http://localhost:3001/api

# FastAPI replay backend used by the v0.3 dashboard. This is intentionally a
# separate variable so the older PostgreSQL snapshot client stays disabled.
VITE_NHL_FASTAPI_BASE_URL=http://127.0.0.1:8000
